{
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ludo.comptoiria.com" }],
      "destination": "/gta-douane/collection/:path*"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
